# Ejemplo de variables de entorno para desarrollo y despliegue
# Copia este archivo a `.env.local` y completa los valores reales (NO subir `.env.local` al repositorio).

NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
# Opcional: token SOLO para server-side (preview, publicación desde servidores)
SANITY_API_TOKEN=your_sanity_api_token_here

# Opcional: Cloudflare Pages deploy hook para triggers manuales (scripts)
CF_DEPLOY_HOOK_URL=https://your-pages-deploy-hook-url
